<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/settings_ripple">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="@color/settings_focus" />
                    <stroke android:width="2dp" android:color="@color/settings_accent" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="@color/settings_surface" android:endColor="@color/settings_surface_end" />
                    <stroke android:width="1dp" android:color="@color/settings_border" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
